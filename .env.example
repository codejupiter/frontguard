# Trusted origins that can submit browser telemetry to /api/security-events.
# The hosted FrontGuard Agent demo and local development origins are already allowed.
FRONTGUARD_EVENT_ORIGINS=

# Optional Redis REST persistence for FrontGuard Suite event triage.
# Vercel Marketplace Upstash injects KV_REST_API_URL and KV_REST_API_TOKEN automatically.
# The app also accepts FRONTGUARD_REDIS_REST_* aliases. It uses the in-memory demo
# adapter when Redis credentials are unset.
KV_REST_API_URL=
KV_REST_API_TOKEN=
FRONTGUARD_REDIS_REST_URL=
FRONTGUARD_REDIS_REST_TOKEN=

# Optional override when multiple environments share the same Redis database.
FRONTGUARD_EVENT_STORE_KEY=frontguard:events:v2

# Storage retention. Use 0 retention days to keep events until max count eviction.
FRONTGUARD_EVENT_MAX_EVENTS=500
FRONTGUARD_EVENT_RETENTION_DAYS=14

# Optional write tokens. When unset, trusted CORS origins can submit demo events.
# When set, POST /api/security-events requires Authorization: Bearer <token>
# or x-frontguard-event-token. Scope format: *=token, org=token,
# org/project=token, or org/project/app=token.
FRONTGUARD_EVENT_WRITE_TOKENS=

# Optional admin token for DELETE /api/security-events.
FRONTGUARD_ADMIN_TOKEN=
